@page "/destinations"
@using MyBlazorApp.Components.Shared
@using MyBlazorApp.Models
@using System.Globalization
@using static Supabase.Postgrest.Constants
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject Supabase.Client Db
@rendermode InteractiveServer

<PageTitle>Roamwild - All Destinations</PageTitle>

<main class="min-h-screen bg-sand text-forest selection:bg-coral selection:text-white pb-24 relative">
    <!-- Solid Header -->
    <header class="bg-forest text-white py-6 px-5 md:px-10 lg:px-16">
        <div class="mx-auto flex max-w-[1440px] items-center justify-between">
            <div class="flex items-center gap-4">
                <a href="/#experiences" class="grid h-10 w-10 place-items-center rounded-full border border-white/35 transition-transform hover:scale-105" aria-label="Back to home">
                    <span class="rotate-180"><AppIcon Name="arrow" Size="18" /></span>
                </a>
                <a href="/" class="logo group flex items-center gap-2.5 text-left">
                    <span class="grid h-10 w-10 place-items-center rounded-full border border-white/45 transition-transform group-hover:rotate-12">
                        <AppIcon Name="compass" Size="22" />
                    </span>
                    <span class="font-display text-[1.55rem] tracking-tight">Roamwild</span>
                </a>
            </div>

            <nav class="hidden items-center gap-9 text-sm font-medium lg:flex">
                <a class="nav-link text-coral" href="/destinations">Destinations</a>
                <a class="nav-link hover:text-coral transition-colors" href="/journal">Journal</a>
                <a class="nav-link hover:text-coral transition-colors" href="/experts">Experts</a>
                <a class="nav-link hover:text-coral transition-colors" href="/contact">Contact</a>
            </nav>

            <a href="/contact" class="hidden h-11 items-center gap-2 rounded-full border border-white/40 px-5 text-sm font-semibold transition-colors hover:bg-white hover:text-forest sm:flex">
                Plan my trip <AppIcon Name="arrow" Size="17" />
            </a>
        </div>
    </header>

    <section class="mx-auto max-w-[1440px] px-5 py-20 md:px-10 lg:px-16">
        <!-- Supabase Connection Notice if not configured -->
        @if (isConfigurationMissing)
        {
            <div class="mb-10 rounded-2xl border border-amber-300 bg-amber-50 p-6 text-amber-900 shadow-sm">
                <div class="flex items-start gap-4">
                    <div class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-amber-200 text-amber-800">
                        <AppIcon Name="compass" Size="20" />
                    </div>
                    <div class="flex-1">
                        <h3 class="font-display text-xl font-bold">Supabase Connection Notice</h3>
                        <p class="mt-1 text-sm leading-relaxed text-amber-800/90">
                            Make sure your Supabase project is active and credentials are set in <code>appsettings.json</code>.
                        </p>
                        <div class="mt-3 flex flex-wrap items-center gap-3">
                            <button @onclick="LoadDestinations" class="rounded-full bg-amber-800 px-4 py-2 text-xs font-semibold text-white transition-opacity hover:opacity-90">
                                Retry Connection
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="mb-10 rounded-2xl border border-red-300 bg-red-50 p-6 text-red-900 shadow-sm">
                <div class="flex items-start gap-3">
                    <div class="flex-1">
                        <h4 class="font-bold text-red-800">Notice</h4>
                        <p class="text-sm mt-1">@errorMessage</p>
                        <button @onclick="LoadDestinations" class="mt-3 rounded-full bg-red-800 px-4 py-1.5 text-xs font-semibold text-white hover:bg-red-900">
                            Retry
                        </button>
                    </div>
                </div>
            </div>
        }

        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
            <div>
                <p class="text-xs font-bold uppercase tracking-[0.2em] text-coral">Explore the Globe</p>
                <h1 class="font-display text-5xl md:text-7xl leading-tight mt-4">
                    All <em>Destinations.</em>
                </h1>
            </div>

            <!-- Action buttons -->
            <div class="flex flex-wrap items-center gap-3">
                <button @onclick="OpenAddModal" class="inline-flex items-center gap-2 rounded-full bg-coral px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-coral/25 transition-all hover:bg-coral-dark hover:scale-105">
                    <AppIcon Name="plus" Size="16" /> Add Journey
                </button>

                <button @onclick="OpenInquiriesModal" class="inline-flex items-center gap-2 rounded-full border border-forest/20 bg-white/70 px-4 py-2.5 text-sm font-semibold text-forest transition-colors hover:bg-white shadow-sm">
                    <AppIcon Name="users" Size="16" /> View Inquiries / Bookings
                </button>

                <button @onclick="ToggleTrashView" class="inline-flex items-center gap-2 rounded-full border border-forest/20 px-4 py-2.5 text-sm font-semibold transition-colors @(showDeleted ? "bg-forest text-white" : "bg-white/60 text-forest hover:bg-white")">
                    <AppIcon Name="trash" Size="15" />
                    @(showDeleted ? "Active Journeys" : "Trash")
                </button>
            </div>
        </div>

        <!-- Search results summary -->
        @if (HasSearch)
        {
            <div class="mt-8 flex flex-wrap items-center gap-3 rounded-2xl bg-white/70 px-5 py-4">
                <p class="text-sm font-medium">
                    <strong>@filteredDestinations.Count</strong> @(filteredDestinations.Count == 1 ? "journey" : "journeys")
                    @if (!string.IsNullOrWhiteSpace(Query))
                    {
                        <text>for <strong>“@Query”</strong></text>
                    }
                </p>

                @if (TravelDate.HasValue)
                {
                    <span class="inline-flex items-center gap-2 rounded-full bg-forest/5 px-3 py-1.5 text-xs font-bold uppercase tracking-widest text-forest/70">
                        <AppIcon Name="calendar" Size="14" /> @TravelDate.Value.ToString("ddd, d MMM yyyy", CultureInfo.InvariantCulture)
                    </span>
                }
                @if (TravellersLabel != null)
                {
                    <span class="inline-flex items-center gap-2 rounded-full bg-forest/5 px-3 py-1.5 text-xs font-bold uppercase tracking-widest text-forest/70">
                        <AppIcon Name="users" Size="14" /> @TravellersLabel
                    </span>
                }

                <button @onclick="ClearSearch" class="ml-auto inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-coral transition-opacity hover:opacity-70">
                    Clear search <AppIcon Name="x" Size="14" />
                </button>
            </div>
        }
        
        <!-- Filter Bar (Habit 2: Filter in Database) -->
        <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-b border-forest/10 pb-6">
            <div class="flex flex-wrap items-center gap-3">
                <span class="text-xs font-bold uppercase tracking-widest text-forest/50 mr-2">Continent:</span>
                
                @foreach (var continent in continents)
                {
                    <button @onclick="() => SetContinentFilter(continent)" 
                            class="px-5 py-2 rounded-full text-sm font-semibold transition-colors @(activeFilter == continent ? "bg-forest text-white shadow" : "bg-white/50 text-forest hover:bg-white")">
                        @continent
                    </button>
                }
            </div>

            <div class="flex items-center gap-2 text-xs font-medium text-forest/60">
                @if (isLoading)
                {
                    <span class="inline-flex items-center gap-2 text-coral animate-pulse">
                        <AppIcon Name="refresh" Size="14" /> Loading from Supabase...
                    </span>
                }
                else
                {
                    <span>Showing <strong>@filteredDestinations.Count</strong> journeys</span>
                }
            </div>
        </div>

        @if (showDeleted)
        {
            <div class="mt-6 rounded-xl bg-forest/5 p-4 text-xs font-semibold uppercase tracking-wider text-forest/70 flex items-center justify-between">
                <span>Displaying Soft-Deleted Journeys (History Pattern Demonstration)</span>
                <span class="text-coral">Items stay preserved in database with deleted_at timestamp</span>
            </div>
        }

        <!-- Destinations Grid -->
        <div class="mt-10 grid gap-7 md:grid-cols-2 lg:grid-cols-3">
            @if (filteredDestinations.Any())
            {
                @foreach (var dest in filteredDestinations)
                {
                    <article class="journey-card group relative rounded-[1.75rem] overflow-hidden bg-white shadow-md transition duration-500 hover:shadow-xl flex flex-col justify-between">
                        <!-- Image Container -->
                        <div class="relative aspect-[4/5] overflow-hidden cursor-pointer" @onclick="() => OpenModal(dest)">
                            <img class="h-full w-full object-cover transition duration-700 group-hover:scale-105" 
                                 src="@dest.Image" 
                                 alt="@dest.Alt" 
                                 onerror="this.src='/images/coron.jpg'" />
                            
                            <div class="absolute inset-0 bg-gradient-to-t from-forest/90 via-forest/20 to-transparent"></div>
                            
                            <!-- Badge -->
                            <span class="absolute left-5 top-5 rounded-full bg-white/95 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-forest backdrop-blur shadow-sm">
                                @dest.Badge
                            </span>

                            @if (dest.DeletedAt != null)
                            {
                                <span class="absolute right-5 top-5 rounded-full bg-red-600/95 px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-white backdrop-blur shadow-sm">
                                    Soft Deleted
                                </span>
                            }

                            <!-- Card Bottom Info -->
                            <div class="absolute bottom-0 left-0 p-6 text-white w-full">
                                <p class="mb-2 flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-white/75">
                                    <AppIcon Name="location" Size="15" /> @dest.Location · @dest.Continent
                                </p>
                                <h3 class="font-display text-2xl lg:text-3xl leading-tight">@dest.Title</h3>
                            </div>
                        </div>

                        <!-- Card Action Bar for CRUD (Step 7 & 8) -->
                        <div class="bg-cream/90 p-4 border-t border-forest/10 flex items-center justify-between gap-2">
                            <button @onclick="() => OpenModal(dest)" class="text-xs font-bold uppercase tracking-widest text-coral hover:text-coral-dark transition-colors flex items-center gap-1.5 py-1 px-2 font-semibold">
                                Book / Inquire <AppIcon Name="arrow" Size="14" />
                            </button>

                            <div class="flex items-center gap-2">
                                @if (dest.DeletedAt == null)
                                {
                                    <!-- Edit Button (Update) -->
                                    <button @onclick="() => OpenEditModal(dest)" 
                                            title="Edit journey details"
                                            class="grid h-9 w-9 place-items-center rounded-full bg-white text-forest shadow-sm transition hover:bg-forest hover:text-white">
                                        <AppIcon Name="edit" Size="15" />
                                    </button>

                                    <!-- Delete Button (Soft Delete) -->
                                    <button @onclick="() => SoftDelete(dest)" 
                                            title="Soft delete journey"
                                            class="grid h-9 w-9 place-items-center rounded-full bg-white text-red-600 shadow-sm transition hover:bg-red-600 hover:text-white">
                                        <AppIcon Name="trash" Size="15" />
                                    </button>
                                }
                                else
                                {
                                    <!-- Restore Button (Soft delete reverse) -->
                                    <button @onclick="() => Restore(dest)" 
                                            title="Restore soft-deleted journey"
                                            class="inline-flex items-center gap-1 rounded-full bg-forest px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-coral">
                                        <AppIcon Name="refresh" Size="13" /> Restore
                                    </button>
                                }
                            </div>
                        </div>
                    </article>
                }
            }
            else if (!isLoading)
            {
                <div class="col-span-full rounded-[1.75rem] bg-white/60 px-8 py-16 text-center">
                    <span class="mx-auto mb-5 grid h-14 w-14 place-items-center rounded-full bg-coral/15 text-coral">
                        <AppIcon Name="search" Size="24" />
                    </span>
                    <h3 class="font-display text-3xl">No journeys found</h3>
                    <p class="mx-auto mt-3 max-w-md text-sm leading-6 text-forest/70">@NoResultsMessage</p>
                    <div class="mt-6 flex flex-wrap justify-center gap-3">
                        @foreach (var suggestion in Suggestions)
                        {
                            <a href="/destinations?query=@Uri.EscapeDataString(suggestion)" class="rounded-full bg-white px-5 py-2 text-sm font-semibold transition-colors hover:bg-forest hover:text-white">@suggestion</a>
                        }
                    </div>
                    <button @onclick="ClearSearch" class="mt-8 rounded-full bg-forest px-8 py-3 text-sm font-semibold text-white transition-transform hover:scale-105">View all destinations</button>
                </div>
            }
        </div>
    </section>

    <!-- Create / Edit Destination Modal (Steps 7 & 8) -->
    @if (isFormModalOpen)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4 overflow-y-auto animate-fadeIn">
            <div class="w-full max-w-lg rounded-[2rem] bg-cream p-8 md:p-10 text-forest shadow-2xl border border-forest/10 my-8">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <span class="text-xs font-bold uppercase tracking-[0.2em] text-coral">
                            @(isEditMode ? "Update Record" : "New Experience")
                        </span>
                        <h3 class="font-display text-3xl leading-tight mt-1">
                            @(isEditMode ? "Edit Destination" : "Add New Journey")
                        </h3>
                    </div>
                    <button @onclick="CloseFormModal" class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-forest/5 text-forest transition-colors hover:bg-forest hover:text-white" aria-label="Close modal">
                        <AppIcon Name="x" Size="18" />
                    </button>
                </div>

                <form @onsubmit="SaveDestination" class="mt-6 space-y-4">
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-widest text-forest/70 mb-1.5">Journey Title *</label>
                        <input required @bind="formModel.Title" class="w-full bg-white border border-forest/15 rounded-xl px-4 py-3 outline-none focus:border-coral transition-colors text-sm" placeholder="e.g. Lagoons beyond the map" />
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-widest text-forest/70 mb-1.5">Location *</label>
                            <input required @bind="formModel.Location" class="w-full bg-white border border-forest/15 rounded-xl px-4 py-3 outline-none focus:border-coral transition-colors text-sm" placeholder="e.g. Coron, Philippines" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-widest text-forest/70 mb-1.5">Continent *</label>
                            <select @bind="formModel.Continent" class="w-full bg-white border border-forest/15 rounded-xl px-4 py-3 outline-none focus:border-coral transition-colors text-sm">
                                <option value="Asia">Asia</option>
                                <option value="Europe">Europe</option>
                                <option value="Africa">Africa</option>
                                <option value="South America">South America</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-widest text-forest/70 mb-1.5">Badge / Duration *</label>
                            <input required @bind="formModel.Badge" class="w-full bg-white border border-forest/15 rounded-xl px-4 py-3 outline-none focus:border-coral transition-colors text-sm" placeholder="e.g. 7 Days" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-widest text-forest/70 mb-1.5">Image Alt Text</label>
                            <input @bind="formModel.Alt" class="w-full bg-white border border-forest/15 rounded-xl px-4 py-3 outline-none focus:border-coral transition-colors text-sm" placeholder="e.g. Tropical lagoon view" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase tracking-widest text-forest/70 mb-1.5">Image URL *</label>
                        <input required @bind="formModel.Image" class="w-full bg-white border border-forest/15 rounded-xl px-4 py-3 outline-none focus:border-coral transition-colors text-sm" placeholder="e.g. /images/coron.jpg or Unsplash URL" />
                        <p class="mt-1 text-xs text-forest/50">Tip: Use <code>/images/coron.jpg</code>, <code>/images/bamboo.jpg</code>, or an image URL.</p>
                    </div>

                    <div class="pt-4 flex items-center justify-end gap-3">
                        <button type="button" @onclick="CloseFormModal" class="rounded-xl px-5 py-3 text-sm font-semibold text-forest/70 hover:bg-forest/5 transition-colors">
                            Cancel
                        </button>
                        <!-- Slide 50 Habit: Disabled button while saving prevents double POSTs -->
                        <button type="submit" disabled="@saving" class="inline-flex items-center justify-center gap-2 rounded-xl bg-coral px-6 py-3 font-semibold text-white transition-all hover:bg-coral-dark disabled:opacity-50">
                            @if (saving)
                            {
                                <AppIcon Name="refresh" Size="16" class="animate-spin" />
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span>@(isEditMode ? "Save Changes" : "Create Journey")</span>
                            }
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    <!-- Functional Booking / Inquiry Modal (Saves to Supabase `inquiries` table) -->
    @if (selectedDestination != null)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4 animate-fadeIn">
            <div class="w-full max-w-md rounded-3xl bg-cream p-6 sm:p-7 text-forest shadow-2xl border border-forest/10 max-h-[90vh] overflow-y-auto">
                <!-- Header -->
                <div class="flex items-start justify-between gap-3 border-b border-forest/10 pb-3.5">
                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-coral">Plan Journey</span>
                        <h3 class="font-display text-2xl leading-tight mt-0.5 text-forest">@selectedDestination.Title</h3>
                        <p class="text-xs text-forest/60 mt-0.5 flex items-center gap-1">
                            <AppIcon Name="location" Size="13" /> @selectedDestination.Location · <span class="text-coral font-semibold">@selectedDestination.Badge</span>
                        </p>
                    </div>
                    <button @onclick="CloseModal" class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-forest/5 text-forest/70 transition-colors hover:bg-forest hover:text-white" aria-label="Close modal">
                        <AppIcon Name="x" Size="15" />
                    </button>
                </div>

                @if (isSubmitted)
                {
                    <div class="text-center py-5">
                        <span class="mx-auto grid h-12 w-12 place-items-center rounded-full bg-emerald-100 text-emerald-700 mb-3">
                            <AppIcon Name="check" Size="22" />
                        </span>
                        <h3 class="font-display text-2xl mb-1 text-forest">Booking Saved!</h3>
                        <p class="text-xs text-coral font-semibold mb-3">
                            Recorded in Supabase as Inquiry #@lastInsertedInquiryId
                        </p>
                        <div class="bg-white/90 rounded-xl p-3.5 text-left text-xs space-y-1.5 border border-forest/10 mb-5">
                            <div><span class="text-forest/60">Traveler:</span> <strong>@userName</strong> (@userEmail)</div>
                            <div><span class="text-forest/60">Date:</span> @(travelDateInput.HasValue ? travelDateInput.Value.ToString("ddd, d MMM yyyy") : "Flexible")</div>
                            <div><span class="text-forest/60">Party:</span> @travellersInput</div>
                            <div><span class="text-forest/60">Status:</span> <span class="rounded bg-emerald-100 text-emerald-800 px-2 py-0.5 font-bold text-[10px]">Pending</span></div>
                        </div>
                        <div class="flex items-center justify-center gap-2">
                            <button @onclick="CloseModal" class="rounded-full bg-forest px-5 py-2 text-xs font-semibold text-white hover:bg-forest/90 transition">
                                Close
                            </button>
                            <button @onclick="async () => { CloseModal(); await OpenInquiriesModal(); }" class="rounded-full bg-coral px-5 py-2 text-xs font-semibold text-white hover:bg-coral-dark transition">
                                View Bookings
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="mt-4">
                        @if (!string.IsNullOrEmpty(inquiryError))
                        {
                            <div class="mb-3 p-2.5 bg-red-50 border border-red-200 text-red-800 rounded-lg text-xs">
                                @inquiryError
                            </div>
                        }

                        <form @onsubmit="SubmitBookingInquiry" class="space-y-3.5">
                            <div>
                                <label class="block text-[11px] font-bold uppercase tracking-wider text-forest/70 mb-1">Your Name *</label>
                                <input required @bind="userName" type="text" class="w-full bg-white border border-forest/20 rounded-xl pl-4 pr-3 py-2.5 text-sm text-forest placeholder:text-forest/35 outline-none focus:border-coral focus:ring-1 focus:ring-coral transition shadow-sm" placeholder="e.g. Jane Doe" />
                            </div>

                            <div>
                                <label class="block text-[11px] font-bold uppercase tracking-wider text-forest/70 mb-1">Email Address *</label>
                                <input required @bind="userEmail" type="email" class="w-full bg-white border border-forest/20 rounded-xl pl-4 pr-3 py-2.5 text-sm text-forest placeholder:text-forest/35 outline-none focus:border-coral focus:ring-1 focus:ring-coral transition shadow-sm" placeholder="jane@example.com" />
                            </div>

                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-[11px] font-bold uppercase tracking-wider text-forest/70 mb-1">Travel Date</label>
                                    <input @bind="travelDateInput" type="date" min="@minDateString" class="w-full bg-white border border-forest/20 rounded-xl pl-4 pr-3 py-2.5 text-xs text-forest outline-none focus:border-coral focus:ring-1 focus:ring-coral transition shadow-sm" />
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold uppercase tracking-wider text-forest/70 mb-1">Party Size</label>
                                    <select @bind="travellersInput" class="w-full bg-white border border-forest/20 rounded-xl pl-4 pr-3 py-2.5 text-xs text-forest outline-none focus:border-coral focus:ring-1 focus:ring-coral transition shadow-sm cursor-pointer">
                                        <option value="1 traveller">1 traveller</option>
                                        <option value="2 travellers">2 travellers</option>
                                        <option value="3 travellers">3 travellers</option>
                                        <option value="4+ travellers">4+ travellers</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Disabled while saving prevents double clicks / double POSTs (Slide 8 & 50) -->
                            <button type="submit" disabled="@isSubmittingInquiry" class="w-full mt-2 flex items-center justify-center gap-2 rounded-xl bg-coral py-3 font-semibold text-white shadow-md transition-all hover:bg-coral-dark disabled:opacity-50 text-xs uppercase tracking-wider">
                                @if (isSubmittingInquiry)
                                {
                                    <AppIcon Name="refresh" Size="14" class="animate-spin" />
                                    <span>Saving to database...</span>
                                }
                                else
                                {
                                    <span>Confirm & Book Journey</span>
                                    <AppIcon Name="arrow" Size="14" />
                                }
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Inquiries / Bookings Drawer Modal (Displays records from Supabase `inquiries` table) -->
    @if (isInquiriesModalOpen)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4 overflow-y-auto animate-fadeIn">
            <div class="w-full max-w-3xl rounded-[2rem] bg-cream p-6 md:p-8 text-forest shadow-2xl border border-forest/10 my-8">
                <div class="flex items-center justify-between border-b border-forest/10 pb-4">
                    <div>
                        <span class="text-xs font-bold uppercase tracking-[0.2em] text-coral">Database Records</span>
                        <h3 class="font-display text-3xl leading-tight mt-1">Travel Inquiries & Bookings</h3>
                    </div>
                    <button @onclick="CloseInquiriesModal" class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-forest/5 text-forest transition-colors hover:bg-forest hover:text-white" aria-label="Close modal">
                        <AppIcon Name="x" Size="18" />
                    </button>
                </div>

                <div class="mt-6 max-h-[60vh] overflow-y-auto space-y-3 pr-2">
                    @if (isLoadingInquiries)
                    {
                        <div class="py-12 text-center text-sm text-forest/60 animate-pulse">
                            <AppIcon Name="refresh" Size="20" class="animate-spin mx-auto mb-2 text-coral" />
                            Loading inquiries from Supabase...
                        </div>
                    }
                    else if (inquiriesList.Any())
                    {
                        @foreach (var inq in inquiriesList)
                        {
                            <div class="rounded-2xl bg-white p-4 border border-forest/10 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
                                <div class="space-y-1">
                                    <div class="flex items-center gap-2">
                                        <span class="font-bold text-base text-forest">@inq.DestinationTitle</span>
                                        <span class="rounded-full bg-forest/5 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-forest/70">
                                            #@inq.Id
                                        </span>
                                    </div>
                                    <p class="text-xs text-forest/70">
                                        Traveler: <strong>@inq.UserName</strong> · <em>@inq.UserEmail</em> · @inq.Travellers
                                    </p>
                                    @if (!string.IsNullOrWhiteSpace(inq.Notes))
                                    {
                                        <p class="text-xs text-forest/50 italic">“@inq.Notes”</p>
                                    }
                                    <p class="text-[10px] text-forest/40">
                                        Submitted: @inq.CreatedAt.ToLocalTime().ToString("g")
                                    </p>
                                </div>
                                <div class="flex items-center gap-2 shrink-0">
                                    <span class="rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wider @(inq.Status == "Confirmed" ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">
                                        @inq.Status
                                    </span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="py-12 text-center text-sm text-forest/60">
                            No inquiries recorded yet. Click "Book / Inquire" on any destination to test adding a record!
                        </div>
                    }
                </div>

                <div class="mt-6 border-t border-forest/10 pt-4 flex justify-between items-center text-xs text-forest/50">
                    <span>Table: <code>public.inquiries</code> in Supabase</span>
                    <button @onclick="LoadInquiries" class="inline-flex items-center gap-1 font-semibold text-coral hover:underline">
                        <AppIcon Name="refresh" Size="14" /> Refresh List
                    </button>
                </div>
            </div>
        </div>
    }
</main>

@code {
    private string activeFilter = "All";
    private readonly string[] continents = { "All", "Asia", "Europe", "Africa", "South America" };
    private List<Destination> allDestinations = new();
    private Destination? selectedDestination = null;
    
    // Booking / Inquiry Form State
    private string userName = "";
    private string userEmail = "";
    private DateTime? travelDateInput;
    private string travellersInput = "1 traveller";
    private string inquiryNotes = "";
    private bool isSubmitted = false;
    private bool isSubmittingInquiry = false;
    private long lastInsertedInquiryId = 0;
    private string? inquiryError = null;

    // Inquiries List Modal State
    private bool isInquiriesModalOpen = false;
    private bool isLoadingInquiries = false;
    private List<Inquiry> inquiriesList = new();

    private bool isLoading = true;
    private bool saving = false;
    private bool showDeleted = false;
    private bool isFormModalOpen = false;
    private bool isEditMode = false;
    private bool isConfigurationMissing = false;
    private string? errorMessage = null;

    // Form Model for Add / Edit Destination
    private DestinationFormModel formModel = new();

    public class DestinationFormModel
    {
        public long Id { get; set; }
        public string Title { get; set; } = "";
        public string Location { get; set; } = "";
        public string Continent { get; set; } = "Asia";
        public string Badge { get; set; } = "7 Days";
        public string Image { get; set; } = "/images/coron.jpg";
        public string Alt { get; set; } = "";
    }

    // Search query parameters from URL
    [Parameter, SupplyParameterFromQuery(Name = "query")] public string? Query { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "date")] public string? DateParam { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "travellers")] public string? TravellersParam { get; set; }

    private static readonly string[] Suggestions = { "Philippines", "Japan", "Switzerland", "Morocco", "Kenya" };
    private static readonly HashSet<string> StopWords = new(StringComparer.OrdinalIgnoreCase) { "the", "and", "island", "islands" };
    private static readonly Dictionary<string, string> Aliases = new(StringComparer.OrdinalIgnoreCase)
    {
        ["palawan"] = "philippines",
        ["swiss"] = "switzerland"
    };

    private DateTime? TravelDate =>
        DateTime.TryParseExact(DateParam, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var d)
        && d.Date >= DateTime.Today.AddDays(1) ? d.Date : null;

    private string? TravellersLabel => TravellersParam switch
    {
        "1" => "1 traveller",
        "2" => "2 travellers",
        "3" => "3 travellers",
        "4" => "4+ travellers",
        _ => null
    };

    private string TripSummary
    {
        get
        {
            var bits = new List<string>();
            if (TravelDate.HasValue) bits.Add(TravelDate.Value.ToString("ddd, d MMM yyyy", CultureInfo.InvariantCulture));
            if (TravellersLabel != null) bits.Add(TravellersLabel);
            return string.Join(" · ", bits);
        }
    }

    private string NoResultsMessage
    {
        get
        {
            var msg = "We couldn’t find a match";
            if (!string.IsNullOrWhiteSpace(Query)) msg += $" for “{Query}”";
            if (activeFilter != "All") msg += $" in {activeFilter}";
            return msg + ". We’re always adding places, so try a popular destination or browse everything.";
        }
    }

    private bool HasSearch => !string.IsNullOrWhiteSpace(Query) || TravelDate.HasValue;

    private List<string> SearchTokens =>
        (Query ?? "").Split(new[] { ',', ' ', '-' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(t => t.Length >= 3 && !StopWords.Contains(t))
            .Select(t => Aliases.TryGetValue(t, out var a) ? a : t)
            .ToList();

    private static int Score(Destination d, List<string> tokens)
    {
        var haystack = $"{d.Title} {d.Location} {d.Continent} {d.Alt}";
        return tokens.Count(t => haystack.Contains(t, StringComparison.OrdinalIgnoreCase));
    }

    private List<Destination> filteredDestinations
    {
        get
        {
            var tokens = SearchTokens;
            if (tokens.Count == 0) return allDestinations;

            return allDestinations.Select(d => (Item: d, Score: Score(d, tokens)))
                                  .Where(x => x.Score > 0)
                                  .OrderByDescending(x => x.Score)
                                  .Select(x => x.Item)
                                  .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDestinations();
    }

    // Step 6 & Fast Habit 2: Fetch rows from Supabase, filter in the database
    private async Task LoadDestinations()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            Supabase.Postgrest.Interfaces.IPostgrestTable<Destination> query = Db.From<Destination>();

            // Fast Habit 2: Filter in the database before fetch
            if (showDeleted)
            {
                query = query.Where(d => d.DeletedAt != null);
            }
            else
            {
                query = query.Where(d => d.DeletedAt == null);
            }

            if (activeFilter != "All")
            {
                query = query.Where(d => d.Continent == activeFilter);
            }

            var response = await query
                .Order(d => d.Id, Ordering.Ascending)
                .Get();

            allDestinations = response.Models;
            isConfigurationMissing = false;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            isConfigurationMissing = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SetContinentFilter(string continent)
    {
        activeFilter = continent;
        await LoadDestinations();
    }

    private async Task ToggleTrashView()
    {
        showDeleted = !showDeleted;
        await LoadDestinations();
    }

    // Step 7: Create: Add a new row (POST)
    // Step 8: Update: Update an existing row (PATCH)
    private async Task SaveDestination()
    {
        if (string.IsNullOrWhiteSpace(formModel.Title) || string.IsNullOrWhiteSpace(formModel.Location))
            return;

        saving = true;
        errorMessage = null;

        try
        {
            if (isEditMode)
            {
                // Step 8 Update: sends PATCH
                await Db.From<Destination>()
                    .Where(x => x.Id == formModel.Id)
                    .Set(x => x.Title, formModel.Title)
                    .Set(x => x.Location, formModel.Location)
                    .Set(x => x.Continent, formModel.Continent)
                    .Set(x => x.Badge, formModel.Badge)
                    .Set(x => x.Image, formModel.Image)
                    .Set(x => x.Alt, string.IsNullOrWhiteSpace(formModel.Alt) ? formModel.Title : formModel.Alt)
                    .Update();
            }
            else
            {
                // Step 7 Create: sends POST
                var newDest = new Destination
                {
                    Title = formModel.Title,
                    Location = formModel.Location,
                    Continent = formModel.Continent,
                    Badge = formModel.Badge,
                    Image = formModel.Image,
                    Alt = string.IsNullOrWhiteSpace(formModel.Alt) ? formModel.Title : formModel.Alt
                };

                await Db.From<Destination>().Insert(newDest);
            }

            CloseFormModal();
            await LoadDestinations();
        }
        catch (Exception ex)
        {
            errorMessage = $"Save error: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    // Step 8 Soft Delete: marks deleted_at timestamp (sends PATCH)
    private async Task SoftDelete(Destination dest)
    {
        try
        {
            await Db.From<Destination>()
                .Where(x => x.Id == dest.Id)
                .Set(x => x.DeletedAt!, DateTime.UtcNow)
                .Update();

            await LoadDestinations();
        }
        catch (Exception ex)
        {
            errorMessage = $"Delete error: {ex.Message}";
        }
    }

    // Restore soft-deleted destination
    private async Task Restore(Destination dest)
    {
        try
        {
            await Db.From<Destination>()
                .Where(x => x.Id == dest.Id)
                .Set(x => x.DeletedAt!, null)
                .Update();

            await LoadDestinations();
        }
        catch (Exception ex)
        {
            errorMessage = $"Restore error: {ex.Message}";
        }
    }

    private void OpenAddModal()
    {
        isEditMode = false;
        formModel = new DestinationFormModel();
        isFormModalOpen = true;
    }

    private void OpenEditModal(Destination dest)
    {
        isEditMode = true;
        formModel = new DestinationFormModel
        {
            Id = dest.Id,
            Title = dest.Title,
            Location = dest.Location,
            Continent = dest.Continent,
            Badge = dest.Badge,
            Image = dest.Image,
            Alt = dest.Alt
        };
        isFormModalOpen = true;
    }

    private void CloseFormModal()
    {
        isFormModalOpen = false;
    }

    private void ClearSearch()
    {
        activeFilter = "All";
        Navigation.NavigateTo("/destinations");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);
        }
    }

    private string minDateString => DateTime.Today.ToString("yyyy-MM-dd");

    private void OpenModal(Destination item)
    {
        selectedDestination = item;
        userName = "";
        userEmail = "";
        travelDateInput = (TravelDate.HasValue && TravelDate.Value.Date >= DateTime.Today)
            ? TravelDate
            : DateTime.Today.AddDays(1);
        travellersInput = TravellersLabel ?? "1 traveller";
        inquiryNotes = "";
        isSubmitted = false;
        inquiryError = null;
    }

    private void CloseModal()
    {
        selectedDestination = null;
    }

    // REAL BOOKING FUNCTION: Inserts inquiry into Supabase `inquiries` table
    private async Task SubmitBookingInquiry()
    {
        if (selectedDestination == null || string.IsNullOrWhiteSpace(userEmail))
            return;

        if (travelDateInput.HasValue && travelDateInput.Value.Date < DateTime.Today)
        {
            inquiryError = "Please select a travel date from today onwards.";
            return;
        }

        isSubmittingInquiry = true;
        inquiryError = null;

        try
        {
            var inquiry = new Inquiry
            {
                DestinationId = selectedDestination.Id,
                DestinationTitle = $"{selectedDestination.Title} · {selectedDestination.Location}",
                UserName = string.IsNullOrWhiteSpace(userName) ? "Traveler" : userName,
                UserEmail = userEmail,
                TravelDate = travelDateInput.HasValue ? travelDateInput.Value.ToUniversalTime() : null,
                Travellers = travellersInput,
                Notes = inquiryNotes,
                Status = "Pending"
            };

            var response = await Db.From<Inquiry>().Insert(inquiry);
            lastInsertedInquiryId = response.Models.FirstOrDefault()?.Id ?? 1;
            isSubmitted = true;
        }
        catch (Exception ex)
        {
            inquiryError = $"Error saving inquiry: {ex.Message}. Make sure you ran the 'inquiries' table SQL in Supabase.";
        }
        finally
        {
            isSubmittingInquiry = false;
        }
    }

    private async Task OpenInquiriesModal()
    {
        isInquiriesModalOpen = true;
        await LoadInquiries();
    }

    private void CloseInquiriesModal()
    {
        isInquiriesModalOpen = false;
    }

    private async Task LoadInquiries()
    {
        isLoadingInquiries = true;
        try
        {
            var response = await Db.From<Inquiry>()
                .Order(i => i.Id, Ordering.Descending)
                .Get();
            inquiriesList = response.Models;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Inquiries] Error loading: {ex.Message}");
        }
        finally
        {
            isLoadingInquiries = false;
        }
    }
}
